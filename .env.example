# Copy to .env and edit.

# Deployment mode: uncomment exactly ONE line to choose how the service is
# exposed. With none uncommented, docker compose uses compose.yaml by default.
# COMPOSE_FILE=compose.yaml             # port-published (publishes PORT on the host)
# COMPOSE_FILE=compose.traefik.yaml     # behind a Traefik reverse proxy
# COMPOSE_FILE=compose.cloudflared.yaml # behind a Cloudflare Tunnel (no published port)

# Port the container serves on (and publishes, for compose.yaml).
# Derived from the project creation date 2026-01-03 (6+01+03 = 60103, over
# 60000 so minus 50000). The Vite dev server uses PORT + 1 = 10104.
PORT=10103

# Image selected by every compose file. IMAGE_TAG is rewritten by the server's deploy script on
# each deploy and rollback (format: <utc date>-<utc hhmm>-<short sha>) - do not
# edit it by hand. Left at latest, docker compose runs the released image.
IMAGE_NAME=ghcr.io/cheminfo/vcl.cheminfo.org
IMAGE_TAG=latest

# Cloudflare Tunnel token (only for compose.cloudflared.yaml)
# TUNNEL_TOKEN=

# Analytics. The snippet the provider hands out, pasted whole and on one line:
# the container puts it at the end of the <head> of every page it serves — one
# file per address is written by the build, so a visitor is counted whichever
# one they arrived at. Unset — a dev run, or a deployment that measures nothing
# — nothing is loaded. Each site has its own id, from https://datami.cheminfo.org.
# TRACKING_SCRIPT=<script defer src="https://datami.cheminfo.org/script.js" data-website-id="26455207-1543-4b2d-9223-77d173144a8d"></script>
